---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageMasthead from '../components/PageMasthead.astro';
import Action from '../components/Action.astro';
import DraftNotice from '../components/DraftNotice.astro';
import Formula from '../components/Formula.astro';
import {href} from '../lib/paths.ts';
---
<SiteLayout title="Interface reference" path="/design-system" noindex><PageMasthead title="A shared language." eyebrow="INTERFACE REFERENCE / INTERNAL" description="The working type, colour, controls and mathematical notation used across the prototype. This page is a review surface, not a learning resource."/><div class="section-pad route-content reference-grid"><section><h2>Three primary colours.</h2><div class="palette-row"><div class="swatch carbon">CARBON<br/>#111513</div><div class="swatch paper">PAPER<br/>#F0F0E9</div><div class="swatch signal">SIGNAL<br/>#C9FF61</div></div><p class="scope-note mono">SUBJECT COLOURS ADD CONTEXT; LABELS KEEP THE MEANING EXPLICIT.</p></section><section><h2>Actions and state.</h2><div class="route-actions"><Action href={href('/subjects/chemistry/reaction-rates')} variant="primary">Read a preview</Action><Action href={href('/explore')} variant="text">Explore</Action><Action disabled>Disabled example</Action></div></section><section><h2>Native controls.</h2><label for="reference-text" class="mono">REFERENCE TEXT FIELD</label><input class="reference-input" id="reference-text" placeholder="A visible label, a clear focus ring" aria-describedby="reference-help"/><p id="reference-help">This is a local interface example. Nothing is submitted or saved.</p><label><input type="checkbox"/> A native checkbox with a text label</label></section><section><h2>Review status.</h2><DraftNotice/><button type="button" class="text-link" data-open="scope-dialog">Read the prototype scope</button></section><section><h2>Native mathematical notation.</h2><Formula subject="mathematics" caption="A native MathML expression with a spoken description; no client math-rendering library."/></section><section><h2>Progressive disclosure.</h2><details class="all-perspectives"><summary>A native disclosure</summary><p>Its text is in the static HTML and can be opened without JavaScript. The same pattern exposes model assumptions and full connection perspectives.</p></details></section></div></SiteLayout>
