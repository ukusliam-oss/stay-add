---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageMasthead from '../../../components/PageMasthead.astro';
import DraftNotice from '../../../components/DraftNotice.astro';
import SubjectArt from '../../../components/SubjectArt.astro';
import Action from '../../../components/Action.astro';
import {subjects} from '../../../data/content.ts';
import {subjectIds,subjectMeta,lessonPath,subjectPath} from '../../../data/subjects.ts';
import {href} from '../../../lib/paths.ts';
import type {SubjectId} from '../../../data/types.ts';
export function getStaticPaths(){return subjectIds.map(id=>({params:{subject:subjectMeta[id].slug},props:{id}}));}
const {id}=Astro.props as {id:SubjectId};
const meta=subjectMeta[id], preview=subjects[id];
---
<SiteLayout title={preview.name} path={subjectPath(id)} active="explore">
  <PageMasthead title={preview.name} eyebrow={`${preview.number} / ${meta.category.toUpperCase()}`} description={meta.description} crumbs={[{label:'Explore',path:'/explore'}]}/>
  <section class:list={['section-pad','route-content','subject-overview',id]}>
    <div class="subject-intro"><div><p class="mono">TARGET / CAMBRIDGE IGCSE 2028 · {meta.code}</p><h2>Start with one good question.</h2><p>{preview.question}</p><DraftNotice/></div><SubjectArt subject={id}/></div>
    <div class="route-list"><a href={href(lessonPath(id))}><span class="mono">01 / CONCEPT PREVIEW</span><strong>{meta.lessonTitle}</strong><span class="mono">DRAFT</span><span aria-hidden="true">+</span></a></div>
    <div class="route-actions"><Action href={href(lessonPath(id))} variant="primary">Read the preview</Action><a class="text-link" href={href(lessonPath(id))} data-subject={id}>Quick summary</a></div>
    <p class="scope-note mono">ONE ORIGINAL PREVIEW AVAILABLE. NO FULL-COURSE OR EXAM-COVERAGE CLAIM.</p>
  </section>
</SiteLayout>
