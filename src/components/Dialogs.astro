---
import InfoBody from './InfoBody.astro';
import Icon from './Icon.astro';
import {searchIndex} from '../data/search.ts';
import {href} from '../lib/paths.ts';
---
<dialog id="subject-dialog" class="subject-dialog" aria-labelledby="lesson-title"><button type="button" class="dialog-close icon-button" data-close aria-label="Close concept preview">×</button><div id="lesson-content"><h2 id="lesson-title">Concept preview</h2></div></dialog>
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title"><div class="dialog-heading"><h2 id="search-title">Follow a question.</h2><button type="button" class="dialog-close icon-button" data-close aria-label="Close search">×</button></div><label class="mono" for="concept-search">SEARCH THIS PROTOTYPE</label><input type="search" id="concept-search" placeholder="Try “reaction”, “energy” or “derivative”…" autocomplete="off"/><p class="mono search-caption">CONCEPT PREVIEWS, ONE LAB & CURATED CONNECTIONS</p><ul id="search-results" aria-label="Search results">{searchIndex.map(item=><li><a href={href(item.path)}><span><small>{item.kind}</small>{item.title}</span><span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></li>)}</ul><p id="search-status" role="status" class="mono">{searchIndex.length} results in this prototype.</p><a class="text-link" href={href('/index')}>Open the full index<Icon name="arrow-up-right"/></a></dialog>
<dialog id="scope-dialog" class="info-dialog" aria-labelledby="scope-title"><button type="button" class="dialog-close icon-button" data-close aria-label="Close prototype information">×</button><p class="eyebrow mono">STAY ADD. / V.0.2</p><h2 id="scope-title">A working beginning.</h2><InfoBody kind="scope"/></dialog>
<dialog id="accessibility-dialog" class="info-dialog" aria-labelledby="accessibility-title"><button type="button" class="dialog-close icon-button" data-close aria-label="Close accessibility information">×</button><p class="eyebrow mono">DESIGNED FOR EXPLORATION</p><h2 id="accessibility-title">Make yourself at home.</h2><InfoBody kind="accessibility"/></dialog>
