{
  "name": "stay-add",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "STAY ADD. — An independent interactive science laboratory prototype",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4321",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "build": "node scripts/astro.mjs build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/astro.mjs check && node scripts/check-foundation.mjs && node --test tests/*.test.mjs",
    "verify": "npm run build && npm run check && node scripts/audit-build.mjs",
    "foundation:check": "node scripts/check-foundation.mjs",
    "foundation:ready": "node scripts/check-foundation.mjs --require-ready"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": { "astro": "7.4.4" },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "parse5": "8.0.1"
  }
}
